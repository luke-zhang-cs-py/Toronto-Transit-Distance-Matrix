[run]
omit =
    tests/*
    # Developer scripts, not shipped code. tools/refresh_figures.py keeps
    # the published figures true and is run by hand.
    tools/*
    # A one-shot build tool: it streams a 207 MB GTFS archive and writes
    # an index. Exercising it in the suite would mean shipping the archive.
    tools_build_schedule.py
    # Same: streams the GTFS archive and writes network/bus_routes.json.
    tools_build_buses.py

[report]
exclude_lines =
    pragma: no cover
    # The script entry point: it starts the refresher, prints a summary and
    # calls app.run(). Importing the module under test must not do any of
    # that, so the block cannot execute in the suite. Same exclusion the
    # other Flask projects in this family use.
    if __name__ == .__main__.:
    raise NotImplementedError
