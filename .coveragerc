[run]
omit =
    tests/*
    # Developer scripts, not shipped code. tools/refresh_figures.py keeps
    # the published figures true and is run by hand. tools/build_schedule.py
    # and tools/build_buses.py stream a 207 MB GTFS archive; exercising them
    # in the suite would mean shipping the archive. (This list also named
    # them by their old root-level names, tools_build_*.py, which match
    # nothing since the move into tools/.)
    tools/*

[report]
exclude_lines =
    pragma: no cover
    # The script entry point. Importing the module under test must not
    # start a server, so the block cannot execute in the suite. It is one
    # line -- main() -- and main() itself is measured and tested. Same
    # exclusion the other Flask projects in this family use.
    if __name__ == .__main__.:
    raise NotImplementedError
