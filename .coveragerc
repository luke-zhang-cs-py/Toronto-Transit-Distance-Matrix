[run]
# The whole repository: every module, the build tools included. "." finds the
# root and the packages; tools/ is named as well because it has no
# __init__.py, and coverage does not look for unimported files in a directory
# that is not a package. Naming it means a tool nobody tests reports 0%
# rather than not appearing at all -- which is how four of them stayed out
# of the figure.
source =
    .
    tools
branch = True
omit =
    tests/*
    # The build tools used to be omitted here, on the grounds that they
    # stream a 207 MB GTFS archive. They are tested now against a feed of a
    # few rows written into tmp_path (tests/test_build_*.py), and the figure
    # refresher against a page of a few rows (tests/test_refresh_figures.py).

[report]
fail_under = 100
show_missing = True
# exclude_lines, not exclude_also: exclude_also keeps coverage's built-in
# patterns too -- `pragma: no cover`, `pragma: no branch`, `if TYPE_CHECKING:`
# and `...` stub bodies -- so a pragma anywhere would still hide lines from
# the 100%. This list replaces those defaults, leaving only the one below.
exclude_lines =
    # The script entry point. Importing a module under test must not start
    # a server or a build, so the block cannot execute in the suite. It is
    # one line -- main() -- and main() itself is measured and tested.
    if __name__ == .__main__.:
